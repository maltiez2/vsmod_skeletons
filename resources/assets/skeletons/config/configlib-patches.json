{
  "version": 1,
  "patches": {
    "other": {
      "@skeletons:config/customplayermodels/*.json": {
        "@@*/ExtraTraits": "(remove_models_traits) ? empty_array : value",
        "@@*/AvailableClasses": "(remove_models_classes) ? empty_array : value",
        "@@*/SkipClasses": "(remove_models_classes) ? skip_classes : value"
      }
    },
    "number": {
      "@skeletons:config/customplayermodels/*.json": {
        "@@*/SizeRange/0": "skeleton_min_size_range",
        "@@*/SizeRange/1": "skeleton_max_size_range",
        "@@*/ModelSizeFactor": "skeleton_size_factor",
        "@@*/MaxCollisionBox/0": "skeleton_max_collision_box_horizontal",
        "@@*/MaxCollisionBox/1": "skeleton_max_collision_box_vetrical",
        "@@*/MaxEyeHeight": "skeleton_max_eye_height",
        "@@*/MinEyeHeight": "skeleton_min_eye_height"
      }
    },
    "boolean": {
      "@skeletons:config/customplayermodels/*.json": {
        "@@*/ScaleColliderWithSizeHorizontally": "skeleton_scale_collider_horizontally",
        "@@*/ScaleColliderWithSizeVertically": "skeleton_scale_collider_vertically",
      },
      "skeletons:config/customplayermodels/skeleton.json": {
        "@@*/Enabled": "enable_skeleton_model"
      },
      "skeletons:config/customplayermodels/infected.json": {
        "@@*/Enabled": "enable_infected_model"
      },
      "skeletons:config/customplayermodels/possessed.json": {
        "@@*/Enabled": "enable_possessed_model"
      },
      "skeletons:config/customplayermodels/reanimated.json": {
        "@@*/Enabled": "enable_reanimated_model"
      }
    }
  },
  "constants": {
    "empty_array": [],
    "skip_classes": ["skeletons-commoner", "skeletons-archer", "skeletons-crossbowman", "skeletons-spearman", "skeletons-swordsman", "skeletons-smith", "skeletons-infected-omnivore", "skeletons-infected-carnivore", "skeletons-infected-herbivore", "skeletons-possessed-oathbreaker", "skeletons-possessed-tortured", "skeletons-possessed-burntlive", "skeletons-possessed-traitor", "skeletons-possessed-inventor"]
  },
  "settings": [
    {
      "code": "enable_skeleton_model",
      "type": "boolean",
      "ingui": "skeletons:setting-enable_skeleton_model",
      "default": false
    },
    {
      "code": "enable_possessed_model",
      "type": "boolean",
      "ingui": "skeletons:setting-enable_possessed_model",
      "default": true
    },
    {
      "code": "enable_infected_model",
      "type": "boolean",
      "ingui": "skeletons:setting-enable_infected_model",
      "default": true
    },
    {
      "code": "enable_reanimated_model",
      "type": "boolean",
      "ingui": "skeletons:setting-enable_reanimated_model",
      "default": true
    },
    {
      "code": "remove_models_traits",
      "type": "boolean",
      "ingui": "skeletons:setting-remove_models_traits",
      "default": false
    },
    {
      "code": "remove_models_classes",
      "type": "boolean",
      "ingui": "skeletons:setting-remove_models_classes",
      "default": false
    },
    {
      "code": "skeleton_min_size_range",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_min_size_range",
      "comment": "skeletons:setting-comment-skeleton_min_size_range",
      "default": 0.9,
      "range": {
        "min": 0.1,
        "max": 1.0
      }
    },
    {
      "code": "skeleton_max_size_range",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_max_size_range",
      "comment": "skeletons:setting-comment-skeleton_max_size_range",
      "default": 1.1,
      "range": {
        "min": 1.0,
        "max": 3.0
      }
    },
    {
      "code": "skeleton_size_factor",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_size_factor",
      "comment": "skeletons:setting-comment-skeleton_size_factor",
      "default": 1.0,
      "range": {
        "min": 0.1,
        "max": 3.0
      }
    },
    {
      "code": "skeleton_max_collision_box_vetrical",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_max_collision_box_vetrical",
      "comment": "skeletons:setting-comment-skeleton_max_collision_box_vetrical",
      "default": 1.99,
      "range": {
        "min": 0.1,
        "max": 10.0
      }
    },
    {
      "code": "skeleton_max_collision_box_horizontal",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_max_collision_box_horizontal",
      "comment": "skeletons:setting-comment-skeleton_max_collision_box_horizontal",
      "default": 0.80,
      "range": {
        "min": 0.1,
        "max": 10.0
      }
    },
    {
      "code": "skeleton_max_eye_height",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_max_eye_height",
      "comment": "skeletons:setting-comment-skeleton_max_eye_height",
      "default": 1.95,
      "range": {
        "min": 0.1,
        "max": 10.0
      }
    },
    {
      "code": "skeleton_min_eye_height",
      "type": "float",
      "ingui": "skeletons:setting-skeleton_min_eye_height",
      "default": 0.1,
      "range": {
        "min": 0.1,
        "max": 10.0
      }
    },
    {
      "code": "skeleton_scale_collider_horizontally",
      "type": "boolean",
      "ingui": "skeletons:setting-skeleton_scale_collider_horizontally",
      "default": true
    },
    {
      "code": "skeleton_scale_collider_vertically",
      "type": "boolean",
      "ingui": "skeletons:setting-skeleton_scale_collider_vertically",
      "default": true
    }
  ]
}